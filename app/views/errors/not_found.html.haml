- content_for :title, _('Page not found')
%div{ class: 'mb-32 w-full max-w-md mx-auto bg-white p-8 rounded-lg shadow-md text-center' }
  %p{ class: 'text-5xl font-bold text-gray-300 mb-4' } 404
  %h1{ class: 'text-2xl font-bold text-gray-800 mb-3' }= _('Page not found')
  - if current_user
    %p{ class: 'text-gray-600 mb-6' }= _("The page you're looking for doesn't exist, or you don't have permission to view it.")
    = link_to _('Go to home page'), root_path, class: 'inline-block w-full py-2 bg-blue-500 text-white font-semibold rounded-md hover:bg-blue-600'
  - else
    %p{ class: 'text-gray-600 mb-6' }= _("The page you're looking for doesn't exist, or it may be private. If you have access, log in to continue.")
    = link_to _('Log in'), new_user_session_path, class: 'inline-block w-full py-2 bg-blue-500 text-white font-semibold rounded-md hover:bg-blue-600'
