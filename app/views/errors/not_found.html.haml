- content_for :title, _('Page not found')
= image_tag 'desert.svg', alt: '', class: 'pointer-events-none fixed inset-0 h-full w-full object-cover object-bottom opacity-5'
%div{ class: 'relative mb-32 w-full max-w-md mx-auto px-4 text-center motion-safe:animate-fade-up' }
  %p{ class: 'mb-2 text-xs font-semibold uppercase tracking-wider text-gray-500' }= _('Error 404')
  %h1{ class: 'mb-3 text-2xl font-bold text-gray-800' }= _('Page not found')
  - if current_user
    %p{ class: 'mb-6 text-gray-600' }= _("The page you're looking for doesn't exist, or you don't have permission to view it.")
    = link_to _('Go to homepage'), root_path, class: 'font-medium text-blue-600 hover:underline'
  - else
    %p{ class: 'mb-6 text-gray-600' }= _("The page you're looking for doesn't exist, or it may be private. If you have access, log in to continue.")
    = link_to _('Log in'), new_user_session_path, class: 'font-medium text-blue-600 hover:underline'
